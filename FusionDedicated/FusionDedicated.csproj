<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>fusiondedicated</AssemblyName>

    <!--
      Without these the compiler embeds the absolute source path of whoever built it
      into the assembly and its debug symbols, so a binary attached to a release
      would carry the builder's home directory and username.
    -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=./</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

  <!--
    The wire format lives in Protocol/. It was derived by reading LabFusion's source
    and confirmed against captured traffic; see README for what that covers.
  -->

  <ItemGroup>
    <None Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="server.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="blocklist.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
